<Window x:Class="Yakovlev_41_size.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Yakovlev_41_size"
        mc:Ignorable="d"
        Title="Заказ" Height="600" Width="1300" FontFamily="Comic Sans MS">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Дата заказа" FontSize="20" Grid.Row="0" Grid.Column="0"></TextBlock>
        <TextBlock Text="Дата доставки заказа" FontSize="20" Grid.Row="1" Grid.Column="0"></TextBlock>
        <TextBlock Text="ФИО клиента" FontSize="20" Grid.Row="2" Grid.Column="0"></TextBlock>
        <TextBlock Text="Номер заказа" FontSize="20" Grid.Row="3" Grid.Column="0"></TextBlock>

        <DatePicker Name="OrderFormDate" Grid.Row="0" Grid.Column="1" SelectedDateChanged="OrderFormDate_SelectedDateChanged"></DatePicker>
        <DatePicker Name="OrderDeliveryDate" Grid.Row="1" Grid.Column="1" IsEnabled="False"></DatePicker>
        <TextBlock Name="FIOBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" FontSize="20"/>
        <TextBlock Name="OrderNumBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" FontSize="20"></TextBlock>

        <ListView Name="OrderedProductList" Grid.Row="4" Grid.ColumnSpan="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="1000"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Image Margin="10" Grid.Column="0" Stretch="UniformToFill" HorizontalAlignment="Center" Grid.RowSpan="5">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>img/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProductName}" FontSize="20"></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProductDescription}" FontSize="20" TextWrapping="Wrap"></TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProductManufacturer}" FontSize="20"></TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProductCost, StringFormat= {}{0} рублей}" FontSize="20"></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="*Скидка" FontSize="20" HorizontalAlignment="Center"></TextBlock>
                        <TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding ProductDiscountAmount, StringFormat={}{0}%}" FontSize="25" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="5">
                            <Button Name="MinusBtn" Content="-" Click="MinusBtn_Click" Width="30"/>
                            <TextBlock Name="QuantityTB" Width="50" FontSize="30" Text="{Binding ProductQuantityInStock}"></TextBlock>
                            <Button Name="PlusBtn"  Content="+" Click="PlusBtn_Click" Width="30"/>
                        </StackPanel>
                        <Button Name="DeleteBtn" Grid.Column="1" Grid.Row="5" Content="Убрать" Width="75" Height="30" Click="DeleteBtn_Click" HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="5" Text="Пункт выдачи" FontSize="20"/>
        <ComboBox Name="PickUpPointCombo" Grid.Column="1" Grid.Row="5" SelectionChanged="PickUpPointCombo_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PickUpAddress}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>


        <Button Name="SaveBtn" Grid.Column="1" Grid.Row="6" Content="Сохранить" FontSize="20" Height="auto" Width="120" Click="SaveBtn_Click"></Button>

    </Grid>
</Window>