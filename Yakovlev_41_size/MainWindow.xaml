<Window x:Class="Yakovlev_41_size.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Yakovlev_41_size"
        mc:Ignorable="d"
        Title="Яковлев 41 размер" Height="600" Width="1240" FontFamily="Comic Sans MS" Icon="/img/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Background="#FFFFCC99"/>
        <WrapPanel Grid.Row="0">
            <Image Margin="5" Source="/img/logo.png" HorizontalAlignment="Left"></Image>
            <Button Visibility = "Collapsed"  Content="Перейти в корзину" Name="OrderMenuBtn" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" Width="auto"></Button>
        </WrapPanel>
        <TextBlock Text="ООО 41 Размер" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
        <Frame Grid.Row="1" Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden"></Frame>
        <Button Content="Назад" Name="BtnBack" HorizontalAlignment="Right" Click="BtnBack_Click"></Button>

    </Grid>
</Window>