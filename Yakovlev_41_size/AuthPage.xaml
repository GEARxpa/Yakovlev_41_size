<Page x:Class="Yakovlev_41_size.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Yakovlev_41_size"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1240"
      Title="AuthPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Поля ввода -->
        <TextBlock Text="Логин" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" Margin="20" VerticalAlignment="Bottom" FontSize="30"/>
        <TextBlock Text="Пароль" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" Margin="20" VerticalAlignment="Top" FontSize="30"/>
        <TextBox FontSize="30" Name="LoginTB" Width="300" Height="50" Margin="20" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        <PasswordBox FontSize="30" Name="PassTB" Width="300" Height="50" Margin="20" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- Капча -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed" Name="CaptchaPanel">
            <TextBlock Text="Введите капчу:" FontSize="20" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <TextBlock Name="captchaOneWord" FontSize="22" Margin="5"/>
                <TextBlock Name="captchaTwoWord" FontSize="22" Margin="5" TextDecorations="Strikethrough"/>
                <TextBlock Name="captchaThreeWord" FontSize="22" Margin="5" TextDecorations="Strikethrough"/>
                <TextBlock Name="captchaFourWord" FontSize="22" Margin="5" TextDecorations="Strikethrough"/>
            </StackPanel>
            <TextBox Name="CaptchaTB" Width="200" FontSize="20" HorizontalAlignment="Center" Margin="0,10"/>
        </StackPanel>

        <!-- Кнопки -->
        <Button Click="GuestLoginBtn_Click" Content="Войти как гость" Name="GuestBtn" VerticalAlignment="Bottom" Margin="0,0,0,50" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" Height="75" Width="200"/>
        <Button Click="LoginBtn_Click" Content="Войти" Name="LoginBtn" VerticalAlignment="Bottom" Margin="0,0,0,50" Grid.Row="2" Grid.Column="1" Height="75" Width="200" HorizontalAlignment="Center"/>
    </Grid>
</Page>