<Page x:Class="Yakovlev_41_size.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Yakovlev_41_size"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1240"
      Title="ProductPage" FontFamily="Comic Sans MS">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="75"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Вы авторизованы как " Grid.Column="0" Grid.Row="0" FontSize="20"></TextBlock>
            <TextBlock Text="Роль:" HorizontalAlignment="Right" FontSize="20" Grid.Column="0" Grid.Row="1"></TextBlock>
            <TextBlock Name="FIOTB" Grid.Row="0" Grid.Column="1" FontSize ="20"></TextBlock>
            <TextBlock Name="RoleTB" FontSize="20" Grid.Row="1" Grid.Column="1"></TextBlock>
        </Grid>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Name="OrderMenuBtn" Content="Перейти в корзину" Width="auto" Height="auto" FontSize="20" HorizontalAlignment="Right" Click="OrderMenu_Click" ></Button>
            <StackPanel Margin="10" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Введите название для поиска" TextAlignment="Right" Margin="5" Width="300" FontSize="20" VerticalAlignment="Center"></TextBlock>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" Width="300" FontSize="15" VerticalAlignment="Center"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Name="TBCount" FontSize="20" VerticalAlignment="Center"></TextBlock>
                <TextBlock Text="из" Margin="10,0" FontSize="20" VerticalAlignment="Center"></TextBlock>
                <TextBlock Name="TBAllProducts" FontSize="20" VerticalAlignment="Center"></TextBlock>
            </StackPanel>
        </WrapPanel>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="10">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Выберите скидку для фильтрации" Margin="5" TextAlignment="Right" Width="auto" FontSize="20"></TextBlock>
                <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged" 
                          FontSize="15" Width="175" Height="auto">
                    <TextBlock>Все диапазоны</TextBlock>
                    <TextBlock>От 0% до 9,99%</TextBlock>
                    <TextBlock>От 10% до 14,99%</TextBlock>
                    <TextBlock>От 15% и более</TextBlock>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <RadioButton Content="По возрастанию стоимости" GroupName="Sort" Width="300" FontSize="20" Checked="RButtonUp_Checked" Name="RButtonUp"></RadioButton>
                <RadioButton Content="По убыванию стоимости" GroupName="Sort" Width="300" FontSize="20" Checked="RButtonDown_Checked" Name="RButtonDown"></RadioButton>
            </StackPanel>
        </WrapPanel>
        <ListView Name="ProductListView" Grid.Row="3">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить к заказу" Click="MenuItem_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="800"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Image Width="200" Grid.Column="0" Grid.RowSpan="4" Stretch="UniformToFill" HorizontalAlignment="Center" Margin="10">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>img/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20"></TextBlock>
                        <TextBlock Text="{Binding ProductDescription}" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20"></TextBlock>
                        <TextBlock Text="{Binding ProductManufacturer}" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                        <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" FontSize="16"></TextBlock>
                        <TextBlock Text="Скидка" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center" FontSize="20"></TextBlock>
                        <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0}%}" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" FontSize="30"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>